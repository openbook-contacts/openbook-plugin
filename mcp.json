{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "openbook": {
      "type": "streamable-http",
      "url": "https://api.withopenbook.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "authorizationUrl": "https://api.withopenbook.com/oauth/authorize",
            "tokenUrl": "https://api.withopenbook.com/oauth/token"
          }
        }
      }
    }
  }
}
